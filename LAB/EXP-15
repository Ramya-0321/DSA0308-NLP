

import nltk

grammar = nltk.PCFG.fromstring("""
    S -> NP VP [1.0]

    NP -> Det N [0.6] | N [0.4]

    VP -> V NP [0.7] | V [0.3]

    Det -> 'the' [0.6] | 'a' [0.4]

    N -> 'cat' [0.4] | 'dog' [0.3] | 'ball' [0.3]

    V -> 'chases' [0.6] | 'runs' [0.4]
""")

parser = nltk.InsideChartParser(grammar)

sentence = input("Enter a sentence: ").lower().split()

trees = list(parser.parse(sentence))

if trees:
    print("\nPROBABILISTIC PARSE TREES")
    print("-" * 40)

    for i, tree in enumerate(trees, 1):
        print("\nParse Tree", i)
        print(tree)
        print("Probability:", tree.prob())

else:
    print("\nNo valid parse tree found.")
