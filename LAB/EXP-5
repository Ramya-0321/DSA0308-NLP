
from nltk.stem import PorterStemmer

ps = PorterStemmer()

words = [
    "playing",
    "played",
    "plays",
    "running",
    "runner",
    "happiness",
    "studies",
    "studying",
    "connected",
    "connection",
    "beautiful",
    "cats"
]

print("{:<20} {:<20}".format("Original Word", "Stemmed Word"))
print("-" * 40)

for word in words:
    stem = ps.stem(word)
    print("{:<20} {:<20}".format(word, stem))
