
import nltk

grammar = nltk.CFG.fromstring("""
    S -> NP VP
    NP -> Det N
    VP -> V NP | V
    Det -> 'the' | 'a'
    N -> 'cat' | 'dog' | 'ball'
    V -> 'eats' | 'chases' | 'runs'
""")

parser = nltk.ChartParser(grammar)

sentence = input("Enter a sentence: ").lower().split()

print("\nPARSE TREE")
print("-" * 40)

trees = list(parser.parse(sentence))

if trees:
    for tree in trees:
        print(tree)
        tree.pretty_print()

    trees[0].draw()

else:
    print("No valid parse tree found.")
