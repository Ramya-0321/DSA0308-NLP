
import re

patterns = [
    (r'^(the|a|an)$', 'DT'),       
    (r'^(is|am|are|was|were)$', 'VB'),  
    (r'.*ing$', 'VBG'),            
    (r'.*ed$', 'VBD'),             
    (r'.*ly$', 'RB'),              
    (r'.*ous$|.*ful$|.*able$', 'JJ'),  
    (r'.*s$', 'NNS'),              
    (r'^[A-Z][a-z]*$', 'NNP'),     
    (r'^[a-zA-Z]+$', 'NN'),        
    (r'^[.,!?]$', '.'),            
]

def pos_tagging(sentence):

    words = re.findall(r"\b\w+\b|[.,!?]", sentence)

    print("{:<20} {}".format("WORD", "POS TAG"))
    print("-" * 35)

    for word in words:
        tag = "UNKNOWN"

        for pattern, pos in patterns:
            if re.fullmatch(pattern, word):
                tag = pos
                break

        print("{:<20} {}".format(word, tag))


text = "The boy is playing happily."

pos_tagging(text)
